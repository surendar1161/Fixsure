              "pm.test(\"is a project\", () => pm.expect(job.kind).to.eql(\"project\"));",
              "pm.collectionVariables.set(\"projectId\", job.id);",
              "pm.collectionVariables.set(\"projectKey\", new URL(job.links.customer, \"http://x\").searchParams.get(\"k\"));",
