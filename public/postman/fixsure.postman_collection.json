    {
      "name": "Create sample job",
      "request": {
        "method": "POST",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/v1/jobs/sample",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "jobs",
            "sample"
          ]
        },
        "description": "Creates the bundled faucet job and stores jobId and customerKey.",
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"201 Created with Location\", () => {",
              "  pm.response.to.have.status(201);",
              "  pm.expect(pm.response.headers.get(\"Location\")).to.match(/^\\/api\\/v1\\/jobs\\//);",
              "});",
              "const job = pm.response.json();",
              "const keyOf = (link) => new URL(link, \"http://x\").searchParams.get(\"k\");",
              "pm.collectionVariables.set(\"jobId\", job.id);",
              "pm.collectionVariables.set(\"customerKey\", keyOf(job.links.customer));",
              "pm.test(\"priced and waiting for a hold\", () => pm.expect(job.status).to.eql(\"scoped\"));",
              "pm.test(\"customer view hides the technician link\", () => pm.expect(job.links.technician).to.eql(null));"
            ]
          }
        }
      ]
    },
