        },
        "description": "",
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
              "pm.test(\"reports integrations\", () => pm.expect(pm.response.json().integrations).to.have.keys(\"vision\", \"paypal\", \"elastic\", \"zapier\"));"
            ]
          }
        }
      ]
