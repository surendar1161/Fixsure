              "pm.collectionVariables.set(\"milestoneId\", first.id);",
              "pm.collectionVariables.set(\"milestoneCrewId\", first.crew.id);",
              "pm.test(\"three verification modes\", () => pm.expect(new Set(job.project.milestones.map((m) => m.verification)).size).to.eql(3));"
            ]
