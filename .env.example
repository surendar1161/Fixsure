# Every integration is optional. Without a key the app runs that part in demo
# or fallback mode, and /api/v1/health reports which mode is live.

# Staff key for the review and dispatch desks, and for staff API calls.
# If unset, the desks are open in development and closed in production.
FIXSURE_STAFF_KEY=local-staff-key

# Percent of each job the platform keeps. The rest is paid out to the technician.
PLATFORM_FEE_PERCENT=10

# Project milestones above this amount need a person even when the AI check passes.
MILESTONE_HUMAN_REVIEW_ABOVE_USD=400

# Public URL used in PayPal return links and Zapier events.
# On Render, RENDER_EXTERNAL_URL is used when this is empty.
APP_URL=http://localhost:3000

# PayPal REST app from developer.paypal.com > Apps & Credentials (Sandbox).
# Enable Payouts on the sandbox app to pay technicians.
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Vision model that prices the job, compares photos, plans projects, and runs the dispatch copilot.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Elastic Cloud (or Serverless) endpoint and an API key with write access to the index.
ELASTIC_URL=
ELASTIC_API_KEY=
ELASTIC_INDEX=fixsure-jobs

# Zapier "Webhooks by Zapier" > Catch Hook URL.
ZAPIER_HOOK_URL=

# Where jobs.json and photos are stored. Defaults to ./data.
# DATA_DIR=
